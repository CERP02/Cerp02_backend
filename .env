# Server port — the API will be accessible at http://localhost:4000
PORT=4000

# PostgreSQL connection string — update with your actual password
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://neondb_owner:npg_Q9BHet2JgGMZ@ep-odd-lab-aprsasd5.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require
#DATABASE_URL=postgresql://postgres:1234567890@localhost:5432/Cerp

# JWT secret key — change this to a long random string before going to production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cerp_kasoa_secret_jwt_key_change_in_production

# How long a JWT token stays valid before the user must log in again
JWT_EXPIRES_IN=7d

# The URL of the Next.js frontend — used by CORS to allow cross-origin requests
CLIENT_URL=http://localhost:3000

# Email configuration for community issue notifications (using Gmail as example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Twilio configuration for SMS notifications to agencies and citizens
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_FROM=+1234567890
